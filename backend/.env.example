# ---------------------------------------------------------------------------
# Munsiq backend — environment template
# Copy to backend/.env and fill in. backend/.env is git-ignored.
# Every field here maps 1:1 to a field on app.config.Settings.
# ---------------------------------------------------------------------------

# Human-readable application name, surfaced in the OpenAPI title.
APP_NAME=Munsiq API

# Deployment environment. One of: local | dev | prod
ENVIRONMENT=local

# URL prefix every versioned route hangs off.
API_V1_PREFIX=/api/v1

# PostgreSQL DSN. Either postgresql:// or postgresql+asyncpg:// is accepted —
# Settings.async_database_url normalizes it onto the asyncpg driver.
# On Supabase: Project Settings -> Database -> Connection string.
# NOTE: Supabase's `postgres` role carries BYPASSRLS. The application does not
# rely on that — see DB_APP_ROLE below and docs/db.md.
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Role the app drops to for every request transaction, via SET LOCAL ROLE, so
# that RLS constrains the request path even though the connection role carries
# BYPASSRLS. `authenticated` is provisioned by Supabase with neither superuser
# nor BYPASSRLS. Set to "" only if DATABASE_URL already points at a
# non-bypassing role. Migrations never use this — they need the owner role.
DB_APP_ROLE=authenticated

# Echo every SQL statement. Never enable outside local debugging — statements
# can contain extracted field values, which must not reach logs.
DB_ECHO=false

# Connection pool sizing.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Register temporary, UNAUTHENTICATED debug routes such as
# POST /api/v1/documents/probe. Must stay false anywhere reachable
# from a network you do not control.
DEBUG_ENDPOINTS=false

# OpenAI-compatible inference endpoint. Ollama by default.
# NEVER hardcode a model URL anywhere else in the codebase — read it from here.
# Unused in Phase 1 (no model code yet); defined now so nothing is tempted to
# invent its own constant later.
INFERENCE_BASE_URL=http://localhost:11434/v1

# Model name served at INFERENCE_BASE_URL.
INFERENCE_MODEL=munsiq-extractor

# Hard cap on an uploaded document, in bytes. Default 25 MiB.
MAX_UPLOAD_BYTES=26214400
