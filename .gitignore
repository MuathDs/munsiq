# ---------------------------------------------------------------------------
# munsiq — .gitignore
# ---------------------------------------------------------------------------

# Secrets & environment
.env
.env.*
!.env.example
*.pem
*.key

# Data (never commit generated / raw datasets)
data/
!data/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / coverage / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Notebooks
.ipynb_checkpoints/

# Model artifacts / checkpoints
*.ckpt
*.pt
*.bin
*.safetensors
models/
checkpoints/
mlruns/
wandb/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Hard exclusions — added at repo initialization
# ---------------------------------------------------------------------------

# Model weights — never commit
*.gguf
*.safetensors
*.pt
*.onnx

# Dependencies
node_modules/
.venv/
backend/.venv/

# Archives and build artifacts
*.zip
.next/
dist/
build/

# Local data
data/

# Real invoices contain live TRNs, IBANs and supplier names. They must never
# enter git history. The README stays tracked; the documents do not.
samples/*.pdf
samples/*.xml
!samples/README.md

# Env
.env
.env.local
*.env
!.env.example
