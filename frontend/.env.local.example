# ---------------------------------------------------------------------------
# Munsiq frontend — local environment
# Copy to .env.local (git-ignored). Server-side only: none of these are
# NEXT_PUBLIC_, so none of them reach the browser.
# ---------------------------------------------------------------------------

# Where the FastAPI backend listens.
MUNSIQ_API_URL=http://127.0.0.1:8000

# Tenant identity, held SERVER-SIDE by the BFF. Real auth is deferred, so this
# stands in for the org claim a verified JWT will carry. The browser never sees
# or sends it. Get one from: backend/.venv/Scripts/python.exe -m scripts.seed_demo
MUNSIQ_ORG_ID=

# Proves to the backend that this caller is the BFF rather than a browser.
# Must equal TRUSTED_BFF_SECRET in backend/.env, and the backend must have
# TRUSTED_BFF_ENABLED=true. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MUNSIQ_BFF_SECRET=

# Optional. Extra hostnames allowed to load the DEV server besides localhost, for
# opening the app from a phone or another machine on your LAN. Comma-separated;
# a pasted origin such as http://192.168.1.20:3000 is reduced to its hostname.
# Without this Next blocks those requests and the page loads but never hydrates.
# Ignored by `next build` / `next start`.
MUNSIQ_DEV_ORIGINS=
