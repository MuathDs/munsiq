# ---------------------------------------------------------------------------
# munsiq — environment template
# Copy to `.env` and fill in. `.env` is git-ignored and never committed.
# ---------------------------------------------------------------------------

# Anthropic API key used by the data-generation pipeline.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the generation model (defaults to claude-opus-4-8).
# MUNSIQ_MODEL=claude-opus-4-8

# Optional: SDK log level (info | debug) for troubleshooting API calls.
# ANTHROPIC_LOG=info
